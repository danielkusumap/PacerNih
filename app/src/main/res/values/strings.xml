    <!-- D11 Info (8.3) -->
    <string name="info_warmup_title">Pemanasan</string>
    <string name="info_warmup_body">Kegunaan: menyiapkan otot dan napas.\nKapan: awal hampir semua workout.\nContoh: 1,5 km ≤ 8:00.\nPerilaku: target = batas paling lambat; dinilai lulus/gagal.\nTips: pakai target lebih lambat dari bagian utama.</string>
    <string name="info_run_title">Lari</string>
    <string name="info_run_body">Kegunaan: bagian inti (stable/interval/tempo).\nKapan: setiap bagian ber-target.\nContoh: 5 km ≤ 7:00; atau 400 m ≤ 6:00 diulang 3×.\nPerilaku: rata-rata ≤ target; segmen ≥1 km dicek per km.\nTips: segmen 200 m bisa BORDERLINE karena error GPS.</string>
    <string name="info_walk_title">Jalan</string>
    <string name="info_walk_body">Kegunaan: jeda jalan, mis. pola run/walk.\nKapan: run/walk atau saat mengatur napas.\nContoh: jalan 2 menit setelah lari 6 menit.\nPerilaku: biasanya tanpa target; voice mengumumkan jalan/lari.\nTips: pakai batas durasi supaya ritmenya konsisten.</string>
    <string name="info_recovery_title">Pemulihan</string>
    <string name="info_recovery_body">Kegunaan: istirahat aktif antar interval.\nKapan: di antara interval cepat.\nContoh: jogging 200 m ≤ 9:00.\nPerilaku: sama seperti Jalan; beda nama dan kata voice.\nTips: jangan terlalu ketat menargetkannya.</string>
    <string name="info_cooldown_title">Pendinginan</string>
    <string name="info_cooldown_body">Kegunaan: menurunkan intensitas di akhir.\nKapan: setelah bagian utama.\nContoh: 1 km ≤ 8:00.\nPerilaku: seperti Pemanasan; app tidak berhenti sendiri.\nTips: jangan langsung Stop.</string>
    <string name="info_free_title">Lari Bebas (tanpa batas)</string>
    <string name="info_free_body">Kegunaan: merekam tanpa rencana; dipakai otomatis setelah rencana selesai.\nKapan: lari santai atau lanjut setelah rencana.\nContoh: template bawaan Lari Bebas.\nPerilaku: hanya segmen terakhir; berakhir saat Stop; hasil "Tanpa target".\nTips: cocok mengukur pace dan jarak.</string>
    <string name="info_limit_title">Batas</string>
    <string name="info_limit_body">Penjelasan: kapan segmen selesai — Jarak, Durasi, atau Tanpa batas (terakhir).\nContoh: segmen pendek lebih tahan error GPS bila pakai durasi.\nTips: batas jarak lebih intuitif tapi bisa meleset beberapa meter.</string>
    <string name="info_target_title">Target pace</string>
    <string name="info_target_body">Penjelasan: batas paling lambat (menit/km); lebih cepat boleh.\nContoh: target 7:00 → rata-rata harus ≤ 7:00.\nTips: kosong = bebas (tanpa alert, tanpa lulus/gagal).</string>
    <string name="info_margin_title">Margin terlalu cepat</string>
    <string name="info_margin_body">Penjelasan: bila pace live lebih cepat dari target sebesar margin ini, voice bilang "terlalu cepat".\nContoh: target 7:00 + margin 20 → alert bila di bawah 6:40.\nTips: matikan untuk segmen yang boleh ngebut; tak aktif di segmen pendek.</string>
    <string name="info_perkm_title">Per-km check</string>
    <string name="info_perkm_body">Penjelasan: untuk segmen ≥1 km ber-target, tiap km penuh juga harus ≤ target selain rata-rata.\nContoh: 5 km 7:00 gagal jika satu km 7:05.\nTips: matikan bila hanya rata-rata yang penting.</string>
    <string name="info_repeat_title">Repeat</string>
    <string name="info_repeat_body">Penjelasan: mengulang sekelompok segmen — jumlah ulangan atau sampai total jarak.\nContoh: Repeat 3× [200 m cepat, 400 m pemulihan].\nTips: "sampai total jarak" menyelesaikan segmen berjalan dulu, lalu berakhir.</string>
    <string name="info_cue_title">Cue sebelum ganti segmen</string>
    <string name="info_cue_body">Penjelasan: segmen waktu → hitung mundur 3-2-1; segmen jarak → satu cue "siap-siap".\nContoh: cue jarak default 20 m.\nTips: bisa diubah/dimatikan di Pengaturan.</string>

