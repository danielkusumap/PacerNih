<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. Compose supplies the real theming; this only styles the window. -->
    <style name="Theme.RunCoach" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Status/navigation bars are drawn behind the Compose content and tinted at runtime to match the
             app palette (RcTheme). Transparent here so no stale purple flashes before the first frame. -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
</resources>
