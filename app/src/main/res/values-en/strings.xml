    <!-- S14 Battery guide -->
    <string name="battery_title">Battery guide</string>
    <string name="battery_intro">So the system does not kill the session while the screen is off, follow these steps and exempt the app from battery optimization.</string>
    <string name="battery_exempt_yes">Battery optimization: already exempted.</string>
    <string name="battery_exempt_no">Battery optimization: not exempted yet.</string>
    <string name="battery_action_open_battery">Open battery settings</string>
    <string name="battery_brand_xiaomi">Xiaomi: Settings &gt; Apps &gt; RunCoach &gt; Battery &gt; No restrictions; enable Autostart.</string>
    <string name="battery_brand_oppo">OPPO/Realme: Settings &gt; Battery &gt; Optimization &gt; RunCoach &gt; Don\'t optimize.</string>
    <string name="battery_brand_vivo">Vivo: Settings &gt; Battery &gt; High background power consumption &gt; RunCoach.</string>
    <string name="battery_brand_samsung">Samsung: Settings &gt; Device care &gt; Battery &gt; Background usage limits &gt; RunCoach.</string>
    <string name="battery_brand_other">Others: Settings &gt; Apps &gt; RunCoach &gt; Battery &gt; Unrestricted.</string>

