    <!-- D11 Info (8.3) -->
    <string name="info_warmup_title">Warm up</string>
    <string name="info_warmup_body">Purpose: prepare muscles and breathing.\nWhen: start of almost every workout.\nExample: 1.5 km ≤ 8:00.\nBehaviour: target is the slowest allowed pace; graded pass/fail.\nTip: set a slower target than the main part.</string>
    <string name="info_run_title">Run</string>
    <string name="info_run_body">Purpose: the main part (steady/interval/tempo).\nWhen: any segment with a target.\nExample: 5 km ≤ 7:00; or 400 m ≤ 6:00 repeated 3×.\nBehaviour: average ≤ target; segments ≥1 km also check each km.\nTip: a 200 m segment can be BORDERLINE due to GPS error.</string>
    <string name="info_walk_title">Walk</string>
    <string name="info_walk_body">Purpose: walking break, e.g. run/walk.\nWhen: run/walk workouts or catching your breath.\nExample: walk 2 min after running 6 min.\nBehaviour: usually no target; voice calls walk/run on change.\nTip: use a duration limit for a steady rhythm.</string>
    <string name="info_recovery_title">Recovery</string>
    <string name="info_recovery_body">Purpose: active rest between fast intervals.\nWhen: between fast intervals.\nExample: jog 200 m ≤ 9:00.\nBehaviour: same as Walk; only the name and voice word differ.\nTip: don\'t target it too strictly.</string>
    <string name="info_cooldown_title">Cool down</string>
    <string name="info_cooldown_body">Purpose: lower intensity at the end.\nWhen: after the main part.\nExample: 1 km ≤ 8:00.\nBehaviour: like Warm up; the app does not stop by itself.\nTip: don\'t stop immediately.</string>
    <string name="info_free_title">Free run (open ended)</string>
    <string name="info_free_body">Purpose: record without a plan; used automatically after the plan ends.\nWhen: casual runs or continuing after a plan.\nExample: built-in "Free run" template.\nBehaviour: last segment only; ends on Stop; result "No target".\nTip: good for measuring pace and distance.</string>
    <string name="info_limit_title">Limit</string>
    <string name="info_limit_body">Explanation: when a segment ends — Distance, Duration, or Open ended (last).\nExample: short segments tolerate GPS error better with a duration.\nTip: a distance limit is intuitive but may be off by a few metres.</string>
    <string name="info_target_title">Target pace</string>
    <string name="info_target_body">Explanation: the slowest allowed pace (min/km); faster is fine.\nExample: target 7:00 → average must be ≤ 7:00.\nTip: empty = free (no alerts, no pass/fail).</string>
    <string name="info_margin_title">Too-fast margin</string>
    <string name="info_margin_body">Explanation: if live pace is faster than target by this margin, voice says "too fast".\nExample: target 7:00 + margin 20 → alert below 6:40.\nTip: turn off for segments you may sprint; inactive on short segments.</string>
    <string name="info_perkm_title">Per-km check</string>
    <string name="info_perkm_body">Explanation: for target segments ≥1 km, every full km must also be ≤ target besides the average.\nExample: 5 km at 7:00 fails if one km is 7:05.\nTip: turn off if only the average matters.</string>
    <string name="info_repeat_title">Repeat</string>
    <string name="info_repeat_body">Explanation: repeats a group of segments — a count or until a total distance.\nExample: Repeat 3× [200 m fast, 400 m recovery].\nTip: "until distance" finishes the running segment first, then ends.</string>
    <string name="info_cue_title">Cue before segment change</string>
    <string name="info_cue_body">Explanation: time segments → 3-2-1 countdown; distance segments → one "get ready" cue.\nExample: default distance cue 20 m.\nTip: configurable in Settings.</string>

